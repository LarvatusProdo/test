import time
import socket
import paramiko

class SFTPClient:
    def __init__(self, host, user, password=None, key_file=None,
                 port=22, keepalive=30):
        self.host, self.user, self.port = host, user, port
        self.password, self.key_file = password, key_file
        self.keepalive = keepalive
        self.ssh = None
        self.sftp = None

    def connect(self):
        self.close()
        self.ssh = paramiko.SSHClient()
        self.ssh.load_system_host_keys()
        self.ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
        self.ssh.connect(self.host, port=self.port, username=self.user,
                         password=self.password, key_filename=self.key_file,
                         timeout=10)
        self.ssh.get_transport().set_keepalive(self.keepalive)
        self.sftp = self.ssh.open_sftp()

    def is_alive(self):
        try:
            t = self.ssh.get_transport() if self.ssh else None
            if t is None or not t.is_active():
                return False
            self.sftp.stat(".")   # vrai aller-retour réseau
            return True
        except Exception:
            return False

    def ensure(self):
        if not self.is_alive():
            self.connect()
        return self.sftp

    def run(self, func, retries=3):
        for attempt in range(1, retries + 1):
            try:
                return func(self.ensure())
            except (OSError, EOFError, socket.error, paramiko.SSHException):
                if attempt == retries:
                    raise
                self.close()
                time.sleep(2 ** attempt)   # 2 s, 4 s...

    def close(self):
        for obj in (self.sftp, self.ssh):
            try:
                if obj:
                    obj.close()
            except Exception:
                pass
        self.sftp = self.ssh = None

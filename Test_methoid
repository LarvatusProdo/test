"""
Recherche du médoïde vrai de chaque cluster K-means
====================================================

Entrées attendues (déjà calculées dans ton notebook) :
    pca_result : array (n_echantillons, n_composantes), sortie de la PCA
    kmeans     : objet KMeans déjà entraîné
    labels     : array (n_echantillons,), issu de kmeans.fit_predict(pca_result)

Définition :
    Le médoïde d'un cluster est l'échantillon RÉEL dont la somme des distances
    à tous les autres membres du cluster est minimale.
    Contrairement au centroïde (moyenne virtuelle), c'est une vraie date ERA5.
"""

import numpy as np
import pandas as pd
from sklearn.metrics import pairwise_distances


def trouver_medoides(pca_result, labels, metric="euclidean", taille_bloc=2000):
    """
    Retourne un DataFrame avec, pour chaque cluster :
        - l'indice du médoïde dans pca_result
        - la taille du cluster
        - la distance moyenne du médoïde aux autres membres

    taille_bloc : nombre de lignes traitées à la fois.
        Le calcul complet coûte n x n distances par cluster. Le traitement
        par blocs donne le MÊME résultat exact, mais limite la mémoire
        (utile si un cluster contient des milliers de dates).
    """
    resultats = []

    for k in np.unique(labels):
        # 1. Indices (dans pca_result) des échantillons du cluster k
        membres = np.where(labels == k)[0]
        Xk = pca_result[membres]
        n = len(membres)

        # 2. Somme des distances de chaque membre à tous les autres membres
        sommes = np.empty(n)
        for debut in range(0, n, taille_bloc):
            fin = min(debut + taille_bloc, n)
            D_bloc = pairwise_distances(Xk[debut:fin], Xk, metric=metric)
            sommes[debut:fin] = D_bloc.sum(axis=1)

        # 3. Le médoïde est le membre avec la plus petite somme
        pos_local = np.argmin(sommes)       # position dans le cluster
        idx_global = membres[pos_local]     # position dans pca_result

        resultats.append({
            "cluster": k,
            "indice_medoide": idx_global,
            "taille_cluster": n,
            "dist_moyenne_medoide": sommes[pos_local] / max(n - 1, 1),
        })

    return pd.DataFrame(resultats).set_index("cluster")


def plus_proches_centroides(pca_result, labels, kmeans):
    """
    Méthode rapide, pour comparaison : échantillon du cluster
    le plus proche de son centroïde.
    """
    indices = {}
    for k in np.unique(labels):
        membres = np.where(labels == k)[0]
        d = np.linalg.norm(pca_result[membres] - kmeans.cluster_centers_[k], axis=1)
        indices[k] = membres[np.argmin(d)]
    return pd.Series(indices, name="indice_proche_centroide")



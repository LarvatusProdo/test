if __name__ == "__main__":
    # >>> Dans ton notebook, supprime ce bloc de démonstration et utilise
    # >>> directement tes variables pca_result, kmeans et labels.
    from sklearn.cluster import KMeans

    rng = np.random.default_rng(0)
    pca_result = np.vstack([
        rng.normal(loc=c, scale=1.0, size=(500, 10)) for c in (-4, 0, 4)
    ])
    kmeans = KMeans(n_clusters=3, n_init=10, random_state=0)
    labels = kmeans.fit_predict(pca_result)
    # <<< fin de la démonstration

    # 1. Médoïdes vrais
    medoides = trouver_medoides(pca_result, labels)

    # 2. Comparaison avec la méthode du plus proche du centroïde
    medoides = medoides.join(plus_proches_centroides(pca_result, labels, kmeans))
    medoides["meme_echantillon"] = (
        medoides["indice_medoide"] == medoides["indice_proche_centroide"]
    )

    print(medoides)

